# Music Streaming Pipeline - Environment Variables
# This is an example .env file for development
# Copy this to .env and update with your actual values

GCP_PROJECT_ID=sublime-blade-484910-a4
BIGQUERY_DATASET=music_streaming_data
BIGQUERY_TABLE=raw_events
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=music-streaming-events
SPARK_MASTER=local[*]
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SPARK_LOG_LEVEL=WARN
LOG_LEVEL=INFO
DRY_RUN=false
