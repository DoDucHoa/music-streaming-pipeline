# Airflow .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Airflow
airflow.db
airflow.cfg
unittests.cfg
airflow_login_*
*.pid
*.err
*.log

# Logs
logs/
*.log

# Airflow Scheduler
scheduler_heartbeat.db

# Airflow Web UI
webserver_config.py

# Secrets
.env
*.key
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
