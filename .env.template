# Environment Configuration for Music Streaming Pipeline
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git (already in .gitignore)

# ============================================
# GCP & BigQuery Configuration
# ============================================

# Your Google Cloud Project ID
# Example: my-project-123456
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery dataset name (default: music_streaming_data)
BIGQUERY_DATASET=music_streaming_data

# BigQuery table name (default: raw_events)
BIGQUERY_TABLE=raw_events

# GCP Region (REQUIRED: europe-west3 - must match dataset location)
GCP_REGION=europe-west3

# ============================================
# Kafka Configuration
# ============================================

# Kafka bootstrap servers
# For Docker internal network: kafka:29092
# For host machine: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Kafka topic name
KAFKA_TOPIC=music-streaming-events

# Kafka consumer group ID (optional)
# KAFKA_GROUP_ID=spark-streaming-consumer

# ============================================
# Spark Configuration
# ============================================

# Spark master URL
# local[*] - Run locally with all available cores
# local[2] - Run locally with 2 cores
# spark://host:port - Connect to standalone cluster
SPARK_MASTER=local[*]

# Spark executor memory (e.g., 2g, 4g, 8g)
SPARK_EXECUTOR_MEMORY=2g

# Spark driver memory (e.g., 2g, 4g, 8g)
SPARK_DRIVER_MEMORY=2g

# Spark log level (ERROR, WARN, INFO, DEBUG)
SPARK_LOG_LEVEL=WARN

# ============================================
# Application Configuration
# ============================================

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dry run mode - process data but don't write to BigQuery
# Set to true for testing without writing to BigQuery
DRY_RUN=false

# ============================================
# Development & Testing
# ============================================

# Enable debug mode (more verbose logging)
# DEBUG=false

# Maximum events to process (optional, for testing)
# MAX_EVENTS=1000

# Processing trigger interval in seconds (default: 30)
# TRIGGER_INTERVAL=30

# ============================================
# eventsim Configuration (Optional)
# ============================================

# Number of users to simulate
# EVENTSIM_USERS=1000

# Simulation start date (YYYY-MM-DDTHH:MM:SS)
# EVENTSIM_START_TIME=2024-01-01T00:00:00

# Simulation end date (YYYY-MM-DDTHH:MM:SS)
# EVENTSIM_END_TIME=2024-12-31T23:59:59

# ============================================
# Resource Limits (Docker Compose)
# ============================================

# Maximum CPUs for Spark container
# SPARK_CPU_LIMIT=4

# Maximum memory for Spark container
# SPARK_MEMORY_LIMIT=4G

# ============================================
# Notes
# ============================================
# 1. Required variables:
#    - GCP_PROJECT_ID
#    - Credentials file at: spark-streaming/credentials/gcp-service-account-key.json
#
# 2. Default values are used if variables are not set
#
# 3. For production, consider using secrets management instead of .env file
#
# 4. Update docker-compose.yml if you need to add more environment variables
#
# 5. Restart containers after changing .env: docker compose restart
